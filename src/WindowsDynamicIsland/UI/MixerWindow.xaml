<Window x:Class="WindowsDynamicIsland.UI.MixerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Mixer" Width="390" Height="560" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
 Deactivated="Window_Deactivated">
 <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="20" BorderBrush="#343944" BorderThickness="1">
  <DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
    <DockPanel>
     <TextBlock Text="AUDIO MIXER" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
     <Button Content="×" Width="28" Height="26" Padding="0" DockPanel.Dock="Right" Click="Close_Click"/>
    </DockPanel>
    <TextBlock Text="Controle de áudio" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
   </StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="SAÍDA DO SISTEMA" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,8"/>
     <DockPanel Margin="0,0,0,16">
      <Button x:Name="MasterMuteButton" Content="Mudo" DockPanel.Dock="Right" Click="MasterMute_Click"/>
      <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" ValueChanged="MasterVolume_Changed" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="APLICATIVOS" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,8"/>
     <ItemsControl x:Name="SessionsList">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
         <StackPanel>
          <DockPanel Margin="0,0,0,7">
           <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <Button Content="{Binding MuteLabel}" Tag="{Binding}" DockPanel.Dock="Right" Padding="8,3" Margin="8,0,0,0" Click="SessionMute_Click"/>
          </DockPanel>
          <DockPanel>
           <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
           <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="{StaticResource MutedBrush}" Width="42" TextAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Peak}" Height="3" Margin="0,5,0,0" Background="#343944" Foreground="{StaticResource AccentBrush}"/>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock x:Name="EmptyState" Text="Nenhuma sessão de áudio ativa." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,20"/>
     <TextBlock Text="MICROFONE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,18,0,8"/>
     <DockPanel x:Name="MicrophoneControls" Margin="0,0,0,8">
      <Button x:Name="MicrophoneMuteButton" Content="Mudo" DockPanel.Dock="Right" Click="MicrophoneMute_Click"/>
      <Slider x:Name="MicrophoneVolumeSlider" Minimum="0" Maximum="100" ValueChanged="MicrophoneVolume_Changed" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="NoMicrophoneState" Text="Nenhum microfone padrão disponível." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
   </ScrollViewer>
   <TextBlock DockPanel.Dock="Bottom" Text="Ctrl + Alt + V  ·  Ocultar" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,16,0,0"/>
  </DockPanel>
 </Border>
</Window>
